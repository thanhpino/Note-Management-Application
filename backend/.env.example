# Backend Listener Port
PORT=5000

# [MONGO_URI] Chuỗi kết nối MongoDB
# Ví dụ: mongodb+srv://<user>:<password>@cluster0.mongodb.net/notesdb
MONGO_URI=your_mongo_db_connection_string

# [JWT_SECRET] Khóa bí mật mã hóa Access Token
# Tạo khóa bí mật bằng `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=your_super_secret_jwt_key_here

# [EMAIL SERVICE] Dịch vụ gửi Email hệ thống (Nodemailer - Khuyên dùng Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# [CLOUDINARY]
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# [FRONTEND_URL] URL gốc của Server Web React để bypass CORS
# Dùng "http://localhost:3000" ở máy dev, dùng "https://render.com/.." ở chế độ Prod
FRONTEND_URL=http://localhost:3000
